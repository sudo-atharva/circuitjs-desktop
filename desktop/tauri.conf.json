{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CircuitJS",
  "version": "1.0.0",
  "identifier": "com.circuitjs.desktop",
  "build": {
    "frontendDist": "../war"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "csim"
        ],
        "name": "CircuitJS Circuit",
        "description": "CircuitJS circuit file",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "publisher": "CircuitJS Desktop"
  }
}